#!/bin/sh
# Keep secrets and other identities out of this public repo.
set -e

for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    case "$(git var $ident)" in
        *"<ruben@rsmidt.dev>"*) ;;
        *)
            echo "pre-commit: $ident isn't ruben@rsmidt.dev; run" >&2
            echo "  git config user.email ruben@rsmidt.dev" >&2
            exit 1
            ;;
    esac
done

# Everything under secrets/ must be sops-encrypted.
git diff --cached --name-only --diff-filter=ACMR -- secrets/ | while read -r f; do
    if ! git show ":$f" | grep -qE '^sops:|"sops":'; then
        echo "pre-commit: $f is not sops-encrypted (use \`sops encrypt\`)" >&2
        exit 1
    fi
done

if ! command -v mise >/dev/null 2>&1; then
    echo "pre-commit: mise not found, can't run gitleaks" >&2
    exit 1
fi
exec mise x -- gitleaks git --pre-commit --staged --redact --no-banner .
