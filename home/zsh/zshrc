# Machine-specific config goes in ~/.config/zsh/local.d (untracked).

zsh_conf="$HOME/.config/zsh"

# Before oh-my-zsh, so compinit picks up Homebrew's completions.
case $OSTYPE in
    darwin*) zsh_os=macos ;;
    *)       zsh_os=linux ;;
esac
[[ -r $zsh_conf/os/$zsh_os.zsh ]] && source "$zsh_conf/os/$zsh_os.zsh"

fpath=(~/.zfunc $fpath)

export ZSH="$HOME/.oh-my-zsh"
zstyle ':omz:update' mode reminder  # just remind me to update when it's time

if (( $+commands[starship] )); then
    ZSH_THEME=""
else
    ZSH_THEME="robbyrussell"
fi

plugins=(git docker kitty mise zsh-autosuggestions fast-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

for conf in "$zsh_conf"/conf.d/*.zsh(N) "$zsh_conf"/local.d/*.zsh(N); do
    source "$conf"
done
unset conf zsh_conf zsh_os
