# Managed in ~/dotfiles. Shared settings live in ~/.config/zsh/conf.d; put
# anything machine-specific (work plugins, aliases, secrets) in
# ~/.config/zsh/local.d/*.zsh, which is never tracked.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
zstyle ':omz:update' mode reminder  # just remind me to update when it's time

plugins=(git docker kitty zsh-autosuggestions fast-syntax-highlighting)

# Completion dirs must be on fpath before oh-my-zsh runs compinit.
fpath=(~/.zfunc $fpath)

source $ZSH/oh-my-zsh.sh

zsh_conf="$HOME/.config/zsh"
case $OSTYPE in
    darwin*) zsh_os=macos ;;
    *)       zsh_os=linux ;;
esac
for conf in "$zsh_conf/os/$zsh_os.zsh"(N) "$zsh_conf"/conf.d/*.zsh(N) "$zsh_conf"/local.d/*.zsh(N); do
    source "$conf"
done
unset conf zsh_conf zsh_os
